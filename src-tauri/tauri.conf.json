{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "School 21",
  "version": "1.0.0",
  "identifier": "ru.school21.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Неофициальный клиент платформы School 21",
    "longDescription": "Платформа School 21 в отдельном окне: автовход, уведомления и напоминания в трее, мини-виджет со статистикой, поиск места пира в кампусе.",
    "copyright": "Dlzxn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
