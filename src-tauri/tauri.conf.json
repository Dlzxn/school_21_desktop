{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "School 21",
  "version": "1.1.0",
  "identifier": "ru.school21.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Неофициальный клиент платформы School 21",
    "longDescription": "Платформа School 21 в отдельном окне: автовход, закладки, «Мои друзья», уведомления и напоминания в трее, поиск места пира в кампусе.",
    "copyright": "Dlzxn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwMkM1MTBCQUJERjVCQTYKUldTbVc5K3JDMUVzNENQbFZCMWxxdHFEckFsak80bm1OL21EL0IzWC9tcTRSQVEraVZiR28yMkMK",
      "endpoints": [
        "https://github.com/Dlzxn/school_21_desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}